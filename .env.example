# Postgres connection string (Neon via the Vercel Storage tab). Tables are created on first request.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# Direct (non-pooled) connection, used by prisma migrate.
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/dbname?sslmode=require"

# Optional: required to clear the shared whiteboard via API.
ADMIN_SECRET="change-me-to-a-long-random-string"
